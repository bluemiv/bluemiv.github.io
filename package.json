{
  "name": "bluemiv-blog",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "pnpm build && serve out --listen 4000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:policies": "node scripts/migratePolicies.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/noto-serif-jp": "5.3.0",
    "@fontsource-variable/noto-serif-kr": "5.3.0",
    "@ibm/plex-mono": "2.5.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.0",
    "clsx": "^2.1.1",
    "github-slugger": "2.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "2.0.2",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.2",
